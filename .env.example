NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true

# Comma-separated browser origins allowed to call the backend locally.
CORS_ORIGIN=http://localhost:5175

# Docker Compose host port mappings. Container/internal ports remain standard.
BACKEND_PORT=3001
POSTGRES_PORT=5435
REDIS_PORT=6380
POSTGRES_DB=belikeme
POSTGRES_USER=belikeme
POSTGRES_PASSWORD=belikeme_password

# Backend running inside Docker Compose:
DATABASE_URL=postgresql://belikeme:belikeme_password@postgres:5432/belikeme?schema=public
REDIS_URL=redis://redis:6379

# Backend running outside Docker on the host machine:
# DATABASE_URL=postgresql://belikeme:belikeme_password@localhost:5435/belikeme?schema=public
# REDIS_URL=redis://localhost:6380

RATE_LIMIT_TTL=
RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_TTL=
AUTH_RATE_LIMIT_MAX=
ORDER_PENDING_EXPIRES_MINUTES=30
ORDER_EXPIRY_SWEEP_INTERVAL_SECONDS=60
ORDER_EMAILS_ENABLED=

JWT_SECRET=replace_with_a_long_random_local_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
FRONTEND_AUTH_SUCCESS_URL=http://localhost:5175/auth/success
FRONTEND_AUTH_FAILURE_URL=http://localhost:5175/auth/failure

EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

FRONTEND_URL=http://localhost:5175
BACKEND_URL=http://localhost:3001

# Browser-safe frontend variables only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:5175
NEXT_PUBLIC_PAYMENT_RETURN_PATH=/payment/return

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYMENT_RETURN_URL=
PAYMENT_CANCEL_URL=
PAYMENT_WEBHOOK_URL=
ADMIN_EMAILS=
