NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed to call the backend locally.
CORS_ORIGIN=http://localhost:5174

# Local Docker host port mappings. Container/internal ports remain standard.
BACKEND_PORT=3001
POSTGRES_PORT=5435
REDIS_PORT=6380
POSTGRES_DB=belikeme
POSTGRES_USER=
POSTGRES_PASSWORD=

# Backend running outside Docker on the host machine:
# DATABASE_URL=postgresql://<postgres-user>:<postgres-password>@localhost:5435/belikeme?schema=public
# REDIS_URL=redis://localhost:6380
#
# Backend running inside Docker Compose:
# DATABASE_URL=postgresql://<postgres-user>:<postgres-password>@postgres:5432/belikeme?schema=public
# REDIS_URL=redis://redis:6379
DATABASE_URL=
REDIS_URL=

RATE_LIMIT_TTL=
RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_TTL=
AUTH_RATE_LIMIT_MAX=

JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FRONTEND_AUTH_SUCCESS_URL=
FRONTEND_AUTH_FAILURE_URL=

EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

FRONTEND_URL=
BACKEND_URL=

# Browser-safe frontend variables only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:5174
NEXT_PUBLIC_PAYMENT_RETURN_PATH=/payment/return

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYMENT_RETURN_URL=
PAYMENT_CANCEL_URL=
PAYMENT_WEBHOOK_URL=
ADMIN_EMAILS=
