{
  "name": "belikeme-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API foundation for the Belikeme clothing store MVP.",
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "ai:smoke:scope": "ts-node --project tsconfig.json -r tsconfig-paths/register scripts/ai-scope-smoke.ts",
    "ai:smoke:style-intent": "ts-node --project tsconfig.json -r tsconfig-paths/register scripts/ai-style-intent-smoke.ts",
    "ai:smoke:style-localization": "ts-node --project tsconfig.json -r tsconfig-paths/register scripts/ai-style-localization-smoke.ts",
    "ai:smoke:style-refinement": "ts-node --project tsconfig.json -r tsconfig-paths/register scripts/ai-style-refinement-smoke.ts",
    "ai:smoke:style-v2-lite": "ts-node --project tsconfig.json -r tsconfig-paths/register scripts/ai-style-v2-lite-smoke.ts",
    "cart:outfit-smoke": "ts-node --project tsconfig.json -r tsconfig-paths/register scripts/cart-outfit-items-smoke.ts",
    "saved-outfits:smoke": "ts-node --project tsconfig.json -r tsconfig-paths/register scripts/saved-outfits-smoke.ts",
    "ai:smoke:real-provider": "node scripts/ai-smoke-real-provider.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:seed": "ts-node --project tsconfig.json -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.26",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.26",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.27",
    "@payos/node": "^2.0.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.110.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
