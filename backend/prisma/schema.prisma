generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum ChatStatus {
  OPEN
  CLOSED
}

enum ChatSenderRole {
  CUSTOMER
  ADMIN
  AI
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
}

enum OrderFulfillmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  PAYOS
}

enum PaymentReconciliationIssueType {
  LATE_PROVIDER_PAID
  PAID_AFTER_LOCAL_CANCELLED
  PAID_AFTER_LOCAL_EXPIRED
  PAID_STOCK_SHORTAGE
  PROVIDER_LOCAL_STATUS_MISMATCH
}

enum PaymentReconciliationIssueStatus {
  OPEN
  REVIEWING
  RESOLVED
  REFUND_REQUIRED
  REFUNDED
  FULFILLMENT_REQUIRED
}

enum VoucherDiscountType {
  PERCENT
  FIXED
}

enum AssetProvider {
  SUPABASE
}

enum AssetStatus {
  ACTIVE
  DELETE_FAILED
}

model User {
  id                        String             @id @default(uuid()) @db.Uuid
  email                     String             @unique @db.VarChar(320)
  passwordHash              String?            @db.VarChar(255)
  name                      String?            @db.VarChar(120)
  phone                     String?            @db.VarChar(32)
  role                      UserRole           @default(CUSTOMER)
  authProvider              AuthProvider       @default(EMAIL)
  isActive                  Boolean            @default(true)
  googleId                  String?            @unique @db.VarChar(255)
  emailVerified             Boolean            @default(false)
  refreshTokenHash          String?            @db.VarChar(255)
  refreshTokenExpiresAt     DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  passwordResetOtps         PasswordResetOtp[]
  orders                    Order[]
  addresses                 Address[]
  cart                      Cart?
  customerChatConversations ChatConversation[] @relation("CustomerChatConversations")
  chatMessages              ChatMessage[]      @relation("UserChatMessages")
  returnRequests            ReturnRequest[]    @relation("CustomerReturnRequests")
  reviewedReturnRequests    ReturnRequest[]    @relation("ReviewedReturnRequests")
  uploadedImageAssets       ImageAsset[]       @relation("UploadedImageAssets")

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@index([refreshTokenExpiresAt])
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String   @db.VarChar(120)
  phone         String   @db.VarChar(20)
  province      String   @db.VarChar(120)
  district      String   @db.VarChar(120)
  ward          String   @db.VarChar(120)
  addressLine   String   @db.VarChar(255)
  note          String?  @db.VarChar(500)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, isDefault])
}

model PasswordResetOtp {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String    @db.VarChar(320)
  otpHash   String    @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
  @@index([email, usedAt, expiresAt])
}

model ChatConversation {
  id            String        @id @default(uuid()) @db.Uuid
  customerId    String        @db.Uuid
  customer      User          @relation("CustomerChatConversations", fields: [customerId], references: [id])
  status        ChatStatus    @default(OPEN)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastMessageAt DateTime?
  messages      ChatMessage[]

  @@index([customerId])
  @@index([status])
  @@index([lastMessageAt])
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @db.Uuid
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?          @db.Uuid
  sender         User?            @relation("UserChatMessages", fields: [senderId], references: [id])
  senderRole     ChatSenderRole
  body           String           @db.VarChar(2000)
  messageType    String           @default("text") @db.VarChar(32)
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Category {
  id                  String            @id @default(uuid()) @db.Uuid
  name                String            @db.VarChar(120)
  slug                String            @unique @db.VarChar(160)
  description         String?
  imageUrl            String?           @db.VarChar(2048)
  managedImageAssetId String?           @unique @db.Uuid
  managedImageAsset   ImageAsset?       @relation("CategoryManagedImage", fields: [managedImageAssetId], references: [id], onDelete: SetNull)
  isFeatured          Boolean           @default(false)
  featuredOrder       Int?              @unique
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  primaryProducts     Product[]         @relation("PrimaryProductCategory")
  productCategories   ProductCategory[]

  @@index([isActive])
  @@index([isActive, isFeatured, featuredOrder])
}

model LandingPageSetting {
  id           String   @id @default("default") @db.VarChar(32)
  heroImageUrl String?  @db.VarChar(2048)
  heroEyebrow  String?  @db.VarChar(120)
  heroTitle    String?  @db.VarChar(160)
  heroSubtitle String?  @db.VarChar(300)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LandingGalleryImage {
  id                  String      @id @default(uuid()) @db.Uuid
  imageUrl            String?     @db.VarChar(1000)
  managedImageAssetId String?     @unique @db.Uuid
  managedImageAsset   ImageAsset? @relation("LandingGalleryManagedImage", fields: [managedImageAssetId], references: [id], onDelete: SetNull)
  title               String?     @db.VarChar(80)
  caption             String?     @db.VarChar(160)
  altText             String?     @db.VarChar(160)
  sortOrder           Int         @default(0)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model Product {
  id                String            @id @default(uuid()) @db.Uuid
  categoryId        String            @db.Uuid
  category          Category          @relation("PrimaryProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  name              String            @db.VarChar(160)
  slug              String            @unique @db.VarChar(180)
  description       String?
  basePrice         Int
  imageUrls         String[]          @default([])
  aiTags            String[]          @default([])
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  variants          ProductVariant[]
  orderItems        OrderItem[]
  productCategories ProductCategory[]
  managedImages     ProductImage[]

  @@index([categoryId])
  @@index([isActive])
  @@index([basePrice])
}

model ImageAsset {
  id                  String               @id @default(uuid()) @db.Uuid
  provider            AssetProvider        @default(SUPABASE)
  bucket              String               @db.VarChar(100)
  storagePath         String               @db.VarChar(500)
  publicUrl           String               @db.VarChar(2048)
  originalFilename    String?              @db.VarChar(255)
  mimeType            String               @db.VarChar(100)
  sizeBytes           Int
  width               Int?
  height              Int?
  checksum            String?              @db.VarChar(64)
  uploadedById        String               @db.Uuid
  uploadedBy          User                 @relation("UploadedImageAssets", fields: [uploadedById], references: [id], onDelete: Restrict)
  status              AssetStatus          @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  productImage        ProductImage?
  categoryImage       Category?            @relation("CategoryManagedImage")
  landingGalleryImage LandingGalleryImage? @relation("LandingGalleryManagedImage")

  @@unique([provider, bucket, storagePath])
  @@index([uploadedById, createdAt])
  @@index([status])
}

model ProductImage {
  id           String     @id @default(uuid()) @db.Uuid
  productId    String     @db.Uuid
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageAssetId String     @unique @db.Uuid
  imageAsset   ImageAsset @relation(fields: [imageAssetId], references: [id], onDelete: Cascade)
  sortOrder    Int
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([productId, sortOrder])
}

model ProductCategory {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductVariant {
  id            String      @id @default(uuid()) @db.Uuid
  productId     String      @db.Uuid
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku           String?     @unique @db.VarChar(80)
  size          String      @db.VarChar(32)
  color         String      @db.VarChar(64)
  stock         Int         @default(0)
  priceOverride Int?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
  cartItems     CartItem[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([isActive])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@index([createdAt])
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model Order {
  id                          String                       @id @default(uuid()) @db.Uuid
  orderCode                   String                       @unique @default(dbgenerated("'BK' || lpad(nextval('\"Order_orderCode_seq\"'::regclass)::text, 6, '0')")) @db.VarChar(16)
  userId                      String                       @db.Uuid
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  status                      OrderStatus                  @default(PENDING_PAYMENT)
  fulfillmentStatus           OrderFulfillmentStatus       @default(PENDING)
  subtotalAmount              Int
  discountAmount              Int                          @default(0)
  totalAmount                 Int
  voucherId                   String?                      @db.Uuid
  voucher                     Voucher?                     @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  voucherCodeSnapshot         String?                      @db.VarChar(64)
  voucherNameSnapshot         String?                      @db.VarChar(160)
  currency                    String                       @default("VND") @db.VarChar(3)
  shippingRecipientName       String?                      @db.VarChar(120)
  shippingPhone               String?                      @db.VarChar(20)
  shippingProvince            String?                      @db.VarChar(120)
  shippingDistrict            String?                      @db.VarChar(120)
  shippingWard                String?                      @db.VarChar(120)
  shippingAddressLine         String?                      @db.VarChar(255)
  shippingNote                String?                      @db.VarChar(500)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  paidAt                      DateTime?
  fulfilledAt                 DateTime?
  cancelledAt                 DateTime?
  expiresAt                   DateTime?
  items                       OrderItem[]
  payments                    Payment[]
  webhookEvents               PaymentWebhookEvent[]
  paymentReconciliationIssues PaymentReconciliationIssue[]
  returnRequests              ReturnRequest[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([voucherId])
  @@index([createdAt])
}

model ReturnRequest {
  id          String              @id @default(uuid()) @db.Uuid
  orderId     String              @db.Uuid
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId  String              @db.Uuid
  customer    User                @relation("CustomerReturnRequests", fields: [customerId], references: [id], onDelete: Restrict)
  reason      String              @db.VarChar(32)
  description String?             @db.VarChar(1000)
  status      ReturnRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?             @db.Uuid
  reviewer    User?               @relation("ReviewedReturnRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String         @id @default(uuid()) @db.Uuid
  orderId     String         @db.Uuid
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String         @db.Uuid
  product     Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId   String         @db.Uuid
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName String         @db.VarChar(160)
  sku         String?        @db.VarChar(80)
  size        String         @db.VarChar(32)
  color       String         @db.VarChar(64)
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  createdAt   DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id                           String                       @id @default(uuid()) @db.Uuid
  orderId                      String                       @db.Uuid
  order                        Order                        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider                     PaymentProvider              @default(PAYOS)
  status                       PaymentStatus                @default(PENDING)
  amount                       Int
  currency                     String                       @default("VND") @db.VarChar(3)
  providerOrderCode            Int                          @unique @default(autoincrement())
  checkoutUrl                  String?
  providerPaymentLinkId        String?                      @unique @db.VarChar(120)
  providerTransactionReference String?                      @db.VarChar(120)
  failureReason                String?                      @db.VarChar(160)
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  paidAt                       DateTime?
  cancelledAt                  DateTime?
  webhookEvents                PaymentWebhookEvent[]
  reconciliationIssues         PaymentReconciliationIssue[]

  @@unique([orderId, provider])
  @@index([orderId])
  @@index([provider, status])
  @@index([createdAt])
}

model PaymentReconciliationIssue {
  id                           String                           @id @default(uuid()) @db.Uuid
  orderId                      String                           @db.Uuid
  order                        Order                            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId                    String                           @db.Uuid
  payment                      Payment                          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  type                         PaymentReconciliationIssueType
  status                       PaymentReconciliationIssueStatus @default(OPEN)
  provider                     PaymentProvider
  providerOrderCode            Int
  providerPaymentLinkId        String?                          @db.VarChar(120)
  providerTransactionReference String?                          @db.VarChar(120)
  amount                       Int
  currency                     String                           @db.VarChar(3)
  safeReason                   String                           @db.VarChar(160)
  createdAt                    DateTime                         @default(now())
  updatedAt                    DateTime                         @updatedAt
  resolvedAt                   DateTime?
  resolvedBy                   String?                          @db.Uuid
  adminNote                    String?                          @db.VarChar(1000)

  @@unique([paymentId, type])
  @@index([orderId, status])
  @@index([provider, providerOrderCode])
  @@index([status, createdAt])
}

model PaymentWebhookEvent {
  id               String          @id @default(uuid()) @db.Uuid
  provider         PaymentProvider
  eventKey         String          @db.VarChar(160)
  signatureHash    String?         @db.VarChar(64)
  paymentId        String?         @db.Uuid
  payment          Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  orderId          String?         @db.Uuid
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  receivedAt       DateTime        @default(now())
  processedAt      DateTime?
  processingStatus String          @default("RECEIVED") @db.VarChar(32)
  metadata         Json?

  @@unique([provider, eventKey])
  @@index([paymentId])
  @@index([orderId])
  @@index([receivedAt])
  @@index([processingStatus])
}

model Voucher {
  id            String              @id @default(uuid()) @db.Uuid
  code          String              @unique @db.VarChar(64)
  name          String              @db.VarChar(160)
  description   String?
  discountType  VoucherDiscountType
  discountValue Int
  minSubtotal   Int
  maxDiscount   Int?
  usageLimit    Int?
  perUserLimit  Int?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  orders        Order[]

  @@index([isActive])
  @@index([createdAt])
}
